# Root-level environment template.
# Each app also has its own .env.example — prefer those for app-specific
# variables. This file documents the shared groups only.

# --- Backend (apps/api) ---
APP_ENV=local
DATABASE_URL=postgresql+asyncpg://vitron:vitron@localhost:5433/vitron
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

