# Admin application environment configuration.
# Copy to .env and adjust. Only NUXT_PUBLIC_* values reach the browser.

# Public API base URL (browser-visible, non-secret).
NUXT_PUBLIC_API_BASE=http://localhost:8000
NUXT_PUBLIC_APP_NAME="Vitron Admin"

# Server-side API base used by Nuxt server routes / SSR fetches.
# NUXT_API_BASE_SERVER=http://localhost:8000
