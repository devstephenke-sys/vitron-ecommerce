# Vitron API environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# Application environment: local | development | staging | production
APP_ENV=local

# PostgreSQL connection string (asyncpg driver).
# Local Docker Compose default is below; use a Neon development branch URL for cloud dev.
DATABASE_URL=postgresql+asyncpg://vitron:vitron@localhost:5433/vitron

# Comma-separated list of allowed CORS origins (no wildcards in deployed envs).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# API prefix for all versioned routes.
API_V1_PREFIX=/api/v1

# JWT signing secret for access tokens. REQUIRED to be a unique value in
# staging/production — the app refuses to boot with the dev default there.
AUTH_SECRET_KEY=vitron-dev-secret-change-me-0123456789abcdef

# Token lifetimes (seconds).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600
